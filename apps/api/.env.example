# Proveedores de Inteligencia Artificial (Gemini obligatorio)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

# Servidor FastAPI
PORT=8000
ENVIRONMENT=development

